# Run browser without a visible window (recommended for production)
HEADLESS=false

# Max page load timeout in milliseconds
TIMEOUT=30000

# Number of automatic retry attempts on navigation/click failures
MAX_RETRIES=3

# Base delay (in seconds) between retries (multiplied per attempt)
RETRY_DELAY=1.0

CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_DIR=.cache

# Maximum requests allowed per window
RATE_LIMIT_REQUESTS=5

# Window size in seconds
RATE_LIMIT_WINDOW=60

# Set to INFO to see detailed browser logs, DEBUG for everything
LOG_LEVEL=WARNING

# Optional proxy server, e.g.: http://user:pass@host:1234
PROXY_URL=
